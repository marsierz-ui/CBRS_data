# Copy this file to .env (which is gitignored) and fill in your values.
# CBRS_import.py loads it automatically.

# Required for LSEG tick collection. With LSEG Workspace running and logged
# in on this machine, the app key alone is enough (desktop session).
# Without it, CBRS_import.py falls back to free Yahoo 1-minute bars.
LSEG_APP_KEY=your-app-key-here

# How many past calendar days to refresh besides today (default 2):
# LSEG_BACKFILL_DAYS=2
